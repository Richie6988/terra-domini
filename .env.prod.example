# HEXOD production env — copy to /home/hexod/terra-domini/.env.prod (chmod 600). Read by settings/prod.py.
DJANGO_SECRET_KEY=generate-with: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=hexod.example.com,www.hexod.example.com
SITE_URL=https://hexod.example.com
SQLITE_PATH=/home/hexod/data/hexod.sqlite3
MEDIA_ROOT=/home/hexod/data/media

# E-mail is REQUIRED: players must verify their email before logging in.
# Reuse PaintIt's SMTP account, or Resend (RESEND_API_KEY=re_xxx) instead of SMTP_*.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=xxx
SMTP_USE_TLS=True
DEFAULT_FROM_EMAIL=Hexod <no-reply@hexod.example.com>

# Optional later: Redis (then raise gunicorn -w) / Stripe / Polygon
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# BLOCKCHAIN_CHAIN_ID=137

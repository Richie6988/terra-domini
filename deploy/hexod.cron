# crontab -u hexod /home/hexod/terra-domini/deploy/hexod.cron
# Replaces Celery beat (no Redis on this VPS).
SHELL=/bin/bash
DJANGO_SETTINGS_MODULE=terra_domini.settings.prod
M=/home/hexod/terra-domini/.venv/bin/python /home/hexod/terra-domini/backend/manage.py
# Bot raids on players (FOMO loop) — every 2h
0 */2 * * *  cd /home/hexod/terra-domini/backend && $M bot_raids >> /home/hexod/data/cron.log 2>&1
# Daily territory resources (HEX itself is collected by players)
30 0 * * *   cd /home/hexod/terra-domini/backend && $M run_production >> /home/hexod/data/cron.log 2>&1
# Real-world events on POI hexes (sports fixtures, strategic points in the news) + pay holders of ended events
5 * * * *    cd /home/hexod/terra-domini/backend && $M world_events >> /home/hexod/data/cron.log 2>&1
# Nightly SQLite backup (keeps 14 days)
0 4 * * *    sqlite3 /home/hexod/data/hexod.sqlite3 ".backup /home/hexod/data/backups/hexod-$(date +\%F).sqlite3" && find /home/hexod/data/backups -name '*.sqlite3' -mtime +14 -delete
# Token DB: new candidates from the agents → Wikipedia check (pictures, coordinates) → game, nightly
30 3 * * *   cd /home/hexod/terra-domini && bash deploy/wiki_refresh.sh >> /home/hexod/data/cron.log 2>&1
# Measured terrain (ESA WorldCover + elevation) for territories not measured yet — nightly, resumable
45 2 * * *   cd /home/hexod/terra-domini/backend && HEXOD_TILE_CACHE=/home/hexod/data/tile_cache $M refine_terrain --limit 5000 >> /home/hexod/data/cron.log 2>&1
# Daily auctions: 10 rare place cards a day (opened after midnight UTC) + settle ended ones — hourly
7 * * * *    cd /home/hexod/terra-domini/backend && $M daily_auctions >> /home/hexod/data/cron.log 2>&1
# Open databases (Wikidata categories, iNaturalist photos, PBDB fossils) then Wikipedia check — Sundays
15 4 * * 0   cd /home/hexod/terra-domini && bash deploy/wiki_refresh.sh --external >> /home/hexod/data/cron.log 2>&1
